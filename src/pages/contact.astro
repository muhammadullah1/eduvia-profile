---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBanner from '../components/PageBanner.astro';
import ContactForm from '../components/ContactForm.astro';
import ContactAside from '../components/ContactAside.astro';
import { site } from '../data/site';

const meta = {
  title: `Request a demo | ${site.name}`,
  description: 'Book an Eduvia walkthrough for your school. Talk to the Abler team that builds and deploys the platform.',
  path: '/contact',
};
---

<BaseLayout meta={meta} breadcrumbs={[{ label: 'Contact' }]}>
  <PageBanner
    kicker="Get started"
    title="See Eduvia with your school in mind"
    description="Share your context and we will schedule a focused demo — not a generic sales deck."
  />
  <section class="contact-page">
    <div class="wrap contact-grid">
      <ContactForm />
      <ContactAside />
    </div>
  </section>
</BaseLayout>
