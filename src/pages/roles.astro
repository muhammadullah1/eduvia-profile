---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../data/site';
import { portalRoles } from '../data/content';

const meta = {
  title: `Role portals | ${site.name}`,
  description:
    'Super Admin, Operations Manager, Accountant, Teacher, and Parent portals in Eduvia, each with permissions matched to the job.',
  path: '/roles',
};
---

<BaseLayout meta={meta} breadcrumbs={[{ label: 'Roles' }]}>
  <PageHero
    eyebrow="Roles"
    title="Five portals,"
    accent="one product."
    description="Each role signs in to a dedicated workspace. Menus follow Eduvia navigation; sensitive actions are enforced again on the API."
  />

  <section class="section-block">
    <div class="wrap grid gap-6 md:grid-cols-2">
      {portalRoles.map((role) => (
        <article class="rounded-2xl border border-border bg-card p-6 md:p-8">
          <h2 class="text-xl font-bold text-ink">{role.title}</h2>
          <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{role.summary}</p>
          <ul class="mt-5 space-y-2 text-sm text-ink">
            {role.highlights.map((item) => (
              <li class="flex gap-2">
                <span class="mt-1 text-primary" aria-hidden="true">•</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
    <p class="mx-auto mt-12 max-w-7xl px-6 text-center text-sm text-muted-foreground">
      Module-level detail is on the <a href="/features" class="font-semibold text-primary hover:underline">features page</a>.
    </p>
  </section>
</BaseLayout>
