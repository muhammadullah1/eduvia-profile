---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBanner from '../components/PageBanner.astro';
import { site } from '../data/site';
import { portalRoles } from '../data/content';

const meta = {
  title: `Role portals | ${site.name}`,
  description:
    'Super Admin, Operations Manager, Accountant, Teacher, and Parent portals in Eduvia, each with permissions matched to the job.',
  path: '/roles',
};
---

<BaseLayout meta={meta} breadcrumbs={[{ label: 'Roles' }]}>
  <PageBanner
    kicker="Roles"
    title="Five portals, one product"
    description="Each role signs in to a dedicated workspace. Menus follow Eduvia navigation; sensitive actions are enforced again on the API."
  />

  <section class="section">
    <div class="wrap grid gap-6 md:grid-cols-2">
      {portalRoles.map((role) => (
        <article class="bento-card" data-reveal>
          <h3>{role.title}</h3>
          <p>{role.summary}</p>
          <ul class="mt-4 space-y-2 text-sm text-[var(--edu-body)] list-none p-0 m-0">
            {role.highlights.map((item) => (
              <li class="flex gap-2">
                <span class="text-[var(--edu-brand)]" aria-hidden="true">→</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
    <p class="wrap mt-12 text-center text-sm text-[var(--edu-muted)]">
      Module-level detail is on the <a href="/features" class="font-semibold text-[var(--edu-brand)] hover:underline">features page</a>.
    </p>
  </section>
</BaseLayout>
