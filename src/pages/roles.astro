---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBanner from '../components/PageBanner.astro';
import { site } from '../data/site';
import { portalRoles } from '../data/content';

const meta = {
  title: `Role portals | ${site.name}`,
  description:
    'Super Admin, Operations Manager, Accountant, Teacher, and Parent portals in Eduvia, each with permissions matched to the job.',
  path: '/roles',
};

const roleMeta: Record<string, { tag: string; badgeColor: string; icon: string }> = {
  super_admin: {
    tag: 'Executive & Strategic Control',
    badgeColor: 'bg-emerald-50 text-emerald-800 border-emerald-200',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />`,
  },
  operations_manager: {
    tag: 'Academic & Daily Operations',
    badgeColor: 'bg-blue-50 text-blue-800 border-blue-200',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />`,
  },
  accountant: {
    tag: 'Fee Desk & Daily Receipts',
    badgeColor: 'bg-amber-50 text-amber-800 border-amber-200',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />`,
  },
  teacher: {
    tag: 'Class Delivery & Attendance',
    badgeColor: 'bg-purple-50 text-purple-800 border-purple-200',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />`,
  },
  parent: {
    tag: 'Family Portal & Updates',
    badgeColor: 'bg-rose-50 text-rose-800 border-rose-200',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />`,
  },
};
---

<BaseLayout meta={meta}>
  <PageBanner
    kicker="Role Architectures"
    title="Five purpose-built workspaces"
    description="Each staff member and parent signs in to a dedicated portal configured strictly for their tasks. Menus reflect actual workflows, and sensitive data is guarded at the API layer."
  />

  <section class="section">
    <div class="wrap grid gap-8 md:grid-cols-2">
      {portalRoles.map((role) => {
        const info = roleMeta[role.id] || roleMeta.super_admin;
        return (
          <article class="bento-card border-slate-200 hover:border-emerald-300" data-reveal>
            <div class="flex items-start justify-between gap-4 mb-4">
              <div class="bento-card-icon mb-0">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" set:html={info.icon} />
              </div>
              <span class:list={['inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold border', info.badgeColor]}>
                {info.tag}
              </span>
            </div>

            <h3 class="text-xl font-bold text-slate-900">{role.title}</h3>
            <p class="mt-2 text-sm text-slate-600 leading-relaxed">{role.summary}</p>

            <div class="mt-6 pt-5 border-t border-slate-100 flex-1">
              <div class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3">Key Capabilities</div>
              <ul class="space-y-2.5 text-sm text-slate-700 list-none p-0 m-0">
                {role.highlights.map((item) => (
                  <li class="flex items-start gap-2.5">
                    <span class="inline-flex items-center justify-center w-4 h-4 rounded-full bg-emerald-100 text-emerald-700 flex-shrink-0 mt-0.5">
                      <svg class="w-3 h-3" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
                      </svg>
                    </span>
                    <span class="text-xs sm:text-sm leading-normal">{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </article>
        );
      })}
    </div>

    <div class="wrap mt-16 p-8 rounded-2xl bg-gradient-to-r from-emerald-50 via-teal-50 to-emerald-50 border border-emerald-200/80 text-center">
      <h3 class="text-xl font-bold text-slate-900">Need specific custom roles or sub-teams?</h3>
      <p class="mt-2 text-sm text-slate-600 max-w-lg mx-auto">
        Eduvia's permission engine can be extended with custom capability flags for coordinators, librarians, and hostel staff.
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a href="/contact" class="btn btn-primary">
          <span>Discuss your school roles</span>
          <svg class="w-4 h-4 ml-1" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
          </svg>
        </a>
        <a href="/platform" class="btn btn-ghost">View system overview</a>
      </div>
    </div>
  </section>
</BaseLayout>