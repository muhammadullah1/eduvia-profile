---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const meta = {
  title: `Page Not Found | ${site.name}`,
  description: 'The page you requested is not part of the Eduvia website.',
  path: '/404',
  robots: 'noindex, nofollow',
};
---

<BaseLayout meta={meta}>
  <section class="section">
    <div class="wrap max-w-2xl text-center py-12" data-reveal>
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-100 border border-slate-200 text-xs font-bold text-slate-700 mb-4">
        <span>404 Error</span>
      </div>
      <h1 class="section-title text-4xl sm:text-5xl">Page not found</h1>
      <p class="section-lead mx-auto mt-3">
        The link you followed doesn't exist or has moved. Explore our platform features or return home.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href="/" class="btn btn-primary">
          <span>Return Home</span>
          <svg class="w-4 h-4 ml-1" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
          </svg>
        </a>
        <a href="/contact" class="btn btn-ghost">Contact Team</a>
      </div>
    </div>
  </section>
</BaseLayout>
