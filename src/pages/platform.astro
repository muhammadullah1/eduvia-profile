---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBanner from '../components/PageBanner.astro';
import ProductShell from '../components/ProductShell.astro';
import { site } from '../data/site';

const meta = {
  title: `Platform overview | ${site.name}`,
  description:
    'How Eduvia connects academic setup, teaching workflows, assessments, fees, and family portals in one product.',
  path: '/platform',
};

const flows = [
  {
    id: 'foundation',
    title: 'Set up the year',
    body:
      'Leaders define the current session, classes, subjects, and timetable. Teachers and parents inherit that structure in their portals.',
    preview: {
      role: 'Super Admin',
      section: 'Sessions',
      items: ['Dashboard', 'Sessions', 'Classes', 'Subjects', 'Timetable', 'Settings'],
    },
  },
  {
    id: 'teaching',
    title: 'Run the school week',
    body:
      'Operations marks absences and assigns substitutes. Teachers take attendance, submit daily chapter updates, and enter test marks. Reviews gate what parents see.',
    preview: {
      role: 'Teacher',
      section: 'Attendance',
      items: ['Today', 'My classes', 'Attendance', 'Daily update', 'Weekly tests', 'Marks entry'],
    },
  },
  {
    id: 'family',
    title: 'Keep families informed',
    body:
      'Parents see fees, receipts, timetable, published tests, results, and approved updates. Visibility follows school rules and publishing steps.',
    preview: {
      role: 'Parent',
      section: 'Fees & receipts',
      items: ['My child', 'Attendance', 'Results & DMC', 'Weekly tests', 'Fees & receipts', 'Updates'],
    },
  },
];
---

<BaseLayout meta={meta} breadcrumbs={[{ label: 'Platform' }]}>
  <PageBanner
    kicker="Platform"
    title="How Eduvia fits together"
    description="Connected workflows across five role portals, backed by the same API permissions your school uses in production."
  />

  <section class="section alt">
    <div class="wrap space-y-20">
      {flows.map((flow) => (
        <article id={flow.id} class="grid items-center gap-10 lg:grid-cols-2" data-reveal>
          <div>
            <h2 class="section-title text-2xl">{flow.title}</h2>
            <p class="mt-4 leading-relaxed text-[var(--edu-body)]">{flow.body}</p>
          </div>
          <ProductShell
            role={flow.preview.role}
            section={flow.preview.section}
            items={flow.preview.items}
          />
        </article>
      ))}
    </div>
    <p class="wrap mt-16 text-center">
      <a href="/roles" class="btn btn-ghost">View all role portals</a>
    </p>
  </section>
</BaseLayout>
