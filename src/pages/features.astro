---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBanner from '../components/PageBanner.astro';
import { site } from '../data/site';
import { moduleGroups } from '../data/content';

const meta = {
  title: `Modules and features | ${site.name}`,
  description:
    'Every Eduvia module maps to the live portal: sessions, admissions, timetable, fees, examinations, parent access, and more.',
  path: '/features',
};

const slug = (title: string) =>
  title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
---

<BaseLayout meta={meta} breadcrumbs={[{ label: 'Features' }]}>
  <PageBanner
    kicker="Features"
    title="Modules in the live portal"
    description="This list reflects Eduvia navigation and API capabilities today — not a generic checklist."
  />

  <section class="section">
    <div class="wrap space-y-14">
      {moduleGroups.map((group) => (
        <div data-reveal>
          <h2 class="section-title text-2xl">{group.title}</h2>
          <p class="section-lead">{group.description}</p>
          <ul class="mt-8 grid gap-4 sm:grid-cols-2 list-none p-0 m-0">
            {group.modules.map((mod) => {
              const id = slug(mod.name);
              const feesAnchor = mod.name.includes('Fee') ? 'fees' : id;
              return (
                <li id={feesAnchor} class="bento-card">
                  <h3>{mod.name}</h3>
                  <p>{mod.detail}</p>
                </li>
              );
            })}
          </ul>
        </div>
      ))}
    </div>
    <p class="wrap mt-12 text-center text-sm text-[var(--edu-muted)]">
      Want a guided walkthrough?
      <a href="/contact" class="font-semibold text-[var(--edu-brand)] hover:underline">Request a demo</a>
    </p>
  </section>
</BaseLayout>
