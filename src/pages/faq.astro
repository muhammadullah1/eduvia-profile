---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBanner from '../components/PageBanner.astro';
import { site } from '../data/site';
import { faqs } from '../data/content';

const meta = {
  title: `FAQ | ${site.name}`,
  description:
    'Answers about Eduvia roles, admissions, fees, assessments, parent access, and working with Abler.',
  path: '/faq',
};
---

<BaseLayout meta={meta} breadcrumbs={[{ label: 'FAQ' }]}>
  <PageBanner
    kicker="FAQ"
    title="Questions schools ask us"
    description="Answers grounded in how Eduvia works in the portal today."
  />

  <section class="section alt">
    <div class="wrap max-w-3xl space-y-3">
      {faqs.map((faq) => (
        <details class="bento-card edu-faq" data-reveal>
          <summary>{faq.q}</summary>
          <p>{faq.a}</p>
        </details>
      ))}
    </div>
    <p class="wrap mt-10 max-w-3xl text-center text-sm text-[var(--edu-muted)]">
      <a href="/contact" class="font-semibold text-[var(--edu-brand)] hover:underline">Request a demo</a>
      for school-specific questions.
    </p>
  </section>
</BaseLayout>
