---
import BaseLayout from '../layouts/BaseLayout.astro';
import PortalPreview from '../components/PortalPreview.astro';
import { site } from '../data/site';
import { homePillars, trustPoints } from '../data/content';

const meta = {
  title: `${site.name} | ${site.productLine}`,
  description: site.description,
  path: '/',
  ogImageAlt: 'Eduvia school management platform by Abler',
};
---

<BaseLayout meta={meta}>
  <section class="home-hero">
    <div class="wrap home-hero-grid">
      <div class="home-hero-copy" data-reveal>
        <p class="section-label">{site.abler.tagline}</p>
        <h1>School operations software with <em>role-ready portals</em></h1>
        <p>{site.description}</p>
        <div class="home-hero-actions">
          <a href="/contact" class="action action-primary">Talk to Abler about Eduvia</a>
          <a href="/platform" class="action action-secondary">See how it fits together</a>
        </div>
      </div>
      <div data-reveal>
        <PortalPreview
          role="Operations Manager"
          active="Timetable"
          items={[
            'Overview',
            'Sessions',
            'Classes',
            'Timetable',
            'Substitutes',
            'Admissions',
            'Students',
            'Daily Test Schedule',
          ]}
        />
      </div>
    </div>
  </section>

  <section class="section-block">
    <div class="wrap" data-reveal>
      <p class="section-label">Why schools choose Eduvia</p>
      <h2 class="text-3xl font-extrabold tracking-tight text-[var(--ink)] md:text-4xl">
        Built for accountability, not checkbox demos
      </h2>
      <div class="feature-grid cols-3 mt-10">
        {homePillars.map((pillar) => (
          <article class="card">
            <h3 class="text-lg font-bold text-[var(--ink)]">{pillar.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-[var(--text)]">{pillar.body}</p>
            <a href={pillar.href} class="mt-5 inline-block text-sm font-bold text-[var(--forest)] hover:underline">
              {pillar.cta}
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-block is-card">
    <div class="wrap" data-reveal>
      <h2 class="text-2xl font-extrabold text-[var(--ink)] md:text-3xl">Designed for real school workflows</h2>
      <ul class="mt-10 grid gap-8 md:grid-cols-3">
        {trustPoints.map((point) => (
          <li>
            <h3 class="font-bold text-[var(--ink)]">{point.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-[var(--text)]">{point.body}</p>
          </li>
        ))}
      </ul>
      <p class="mt-12 text-center text-sm text-[var(--text)]">
        <a href="/roles" class="font-bold text-[var(--forest)] hover:underline">Compare role portals</a>
        <span class="mx-2" aria-hidden="true">·</span>
        <a href="/features" class="font-bold text-[var(--forest)] hover:underline">Full module list</a>
      </p>
    </div>
  </section>
</BaseLayout>
