---
import {
  INQUIRY_TYPES,
  SCHOOL_ROLES,
  STUDENT_BANDS,
  TIMELINES,
} from '../lib/contact';
import { site } from '../data/site';
---

<div class="edu-form-card">
  <h2 class="text-lg font-extrabold text-[var(--edu-ink)]">Request a demo</h2>
  <p class="mt-2 text-sm text-[var(--edu-muted)]">We respond within one business day with next steps for your school.</p>
  <form class="edu-form mt-6" data-contact-form data-form-endpoint={site.formEndpoint} novalidate>
    <div class="hp-field" aria-hidden="true">
      <input type="text" name="website" tabindex="-1" autocomplete="off" />
    </div>
    <div class="form-row-2">
      <label><span>Name</span><input type="text" name="name" required maxlength="120" autocomplete="name" /></label>
      <label><span>Work email</span><input type="email" name="email" required maxlength="254" autocomplete="email" /></label>
    </div>
    <label><span>School or group name</span><input type="text" name="school" required maxlength="160" autocomplete="organization" /></label>
    <label>
      <span>Your role</span>
      <select name="role" required>
        <option value="">Select</option>
        {SCHOOL_ROLES.map((v) => <option value={v}>{v}</option>)}
      </select>
    </label>
    <fieldset>
      <legend>What do you need?</legend>
      <div class="edu-chip-grid">
        {INQUIRY_TYPES.map((value) => (
          <label><input type="radio" name="inquiry" value={value} required /><span>{value}</span></label>
        ))}
      </div>
    </fieldset>
    <fieldset>
      <legend>Students enrolled</legend>
      <div class="edu-chip-grid">
        {STUDENT_BANDS.map((value) => (
          <label><input type="radio" name="students" value={value} required /><span>{value}</span></label>
        ))}
      </div>
    </fieldset>
    <label>
      <span>Timeline</span>
      <select name="timeline" required>
        <option value="">Select</option>
        {TIMELINES.map((v) => <option value={v}>{v}</option>)}
      </select>
    </label>
    <label>
      <span>Context for our team</span>
      <textarea name="message" required maxlength="5000" placeholder="Modules you care about, current tools, and any go-live date." />
    </label>
    <button type="submit" class="btn btn-primary btn-block" data-submit-button>
      <span data-submit-label>Send request</span>
      <span class="submit-spinner" data-submit-spinner hidden></span>
    </button>
    <div class="form-toast" data-form-status role="status" aria-live="polite" hidden>
      <span data-status-message></span>
    </div>
  </form>
</div>

<script is:inline define:vars={{ supportEmail: site.abler.email }}>
  const form = document.querySelector('[data-contact-form]');
  const status = document.querySelector('[data-form-status]');
  const statusMessage = status?.querySelector('[data-status-message]');
  const submit = form?.querySelector('[data-submit-button]');
  const submitLabel = submit?.querySelector('[data-submit-label]');
  const submitSpinner = submit?.querySelector('[data-submit-spinner]');
  let startedAt = Date.now();
  let submitting = false;

  const fieldFor = (control) => {
    if (control instanceof HTMLInputElement && control.type === 'radio') return control.closest('fieldset');
    return control.closest('label');
  };

  const setSubmitting = (on) => {
    submitting = on;
    if (submit instanceof HTMLButtonElement) {
      submit.disabled = on;
      submit.setAttribute('aria-busy', String(on));
    }
    if (submitLabel) submitLabel.textContent = on ? 'Sending…' : 'Send request';
    if (submitSpinner instanceof HTMLElement) submitSpinner.hidden = !on;
  };

  const showToast = (msg, tone = 'error') => {
    if (!(status instanceof HTMLElement) || !statusMessage) return;
    status.dataset.tone = tone;
    statusMessage.textContent = msg;
    status.hidden = false;
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!(form instanceof HTMLFormElement) || submitting) return;
    const invalid = [...form.querySelectorAll('[required]')].filter((c) => !c.checkValidity());
    form.querySelectorAll('.is-invalid').forEach((el) => el.classList.remove('is-invalid'));
    if (invalid.length) {
      invalid.forEach((c) => fieldFor(c)?.classList.add('is-invalid'));
      showToast('Please complete all required fields.', 'error');
      return;
    }
    const data = new FormData(form);
    const endpoint = form.dataset.formEndpoint;
    setSubmitting(true);
    try {
      const res = await fetch(endpoint, {
        method: 'POST',
        headers: { Accept: 'application/json', 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: data.get('name'),
          email: data.get('email'),
          school: data.get('school'),
          role: data.get('role'),
          inquiry: data.get('inquiry'),
          students: data.get('students'),
          timeline: data.get('timeline'),
          message: data.get('message'),
          website: data.get('website') || '',
          started: String(startedAt),
        }),
      });
      const result = await res.json().catch(() => ({}));
      if (!res.ok) {
        const code = result.code || '';
        const isLocal = location.hostname === 'localhost' || location.hostname === '127.0.0.1';
        if (isLocal && code === 'CONTACT_NOT_CONFIGURED') {
          showToast('Add RESEND_API_KEY to .env and restart the dev server.', 'error');
        } else {
          showToast(result.error || `Could not send. Email ${supportEmail}.`, 'error');
        }
        return;
      }
      showToast('Thanks — we received your request and will reply soon.', 'success');
      form.reset();
      startedAt = Date.now();
    } catch {
      showToast(`Could not send. Email ${supportEmail}.`, 'error');
    } finally {
      setSubmitting(false);
    }
  });
</script>

<style>
  .submit-spinner {
    width: 1rem;
    height: 1rem;
    border: 2px solid rgb(255 255 255 / 40%);
    border-top-color: #fff;
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
</style>
