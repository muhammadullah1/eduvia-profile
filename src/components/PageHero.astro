---
interface Props {
  eyebrow: string;
  title: string;
  accent?: string;
  description: string;
  wash?: boolean;
}

const { eyebrow, title, accent, description, wash = true } = Astro.props;
---

<section class:list={['page-hero', wash && 'is-wash']} data-reveal>
  <div class="wrap page-intro is-stacked">
    <div>
      <p class="section-label">{eyebrow}</p>
      <h1>
        {title}
        {accent && <><br /><em>{accent}</em></>}
      </h1>
    </div>
    <p class="intro-description">{description}</p>
  </div>
</section>
