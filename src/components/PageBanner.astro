---
interface Props {
  kicker: string;
  title: string;
  description?: string;
}

const { kicker, title, description } = Astro.props;
---

<header class="page-banner">
  <div class="wrap page-banner-inner" data-reveal>
    <div class="page-banner-kicker-wrap">
      <span class="page-banner-kicker-dot"></span>
      <span class="page-banner-kicker">{kicker}</span>
    </div>
    <h1 class="page-banner-title">{title}</h1>
    {description && <p class="page-banner-desc">{description}</p>}
  </div>
</header>