---
import { site } from '../data/site';
---

<aside data-reveal>
  <div class="contact-side-card">
    <h2>Built for school teams</h2>
    <p>Admissions, fees, timetable, exams, and parent portals — one product, five role-based workspaces.</p>
    <a href="/platform" class="btn btn-ghost mt-4">Explore the platform</a>
  </div>
  <div class="contact-side-card" style="background: var(--edu-paper);">
    <p class="kicker">Direct line</p>
    <div class="contact-direct">
      <a href={`mailto:${site.abler.email}`}>{site.abler.email}</a>
      <a href={site.abler.phoneHref}>{site.abler.phone}</a>
      <span class="text-sm text-[var(--edu-muted)]">{site.abler.location}</span>
    </div>
  </div>
  <ol class="mt-4 space-y-2 text-sm text-[var(--edu-body)] list-none p-0 m-0">
    <li><strong class="text-[var(--edu-brand)]">1.</strong> We review your school context.</li>
    <li><strong class="text-[var(--edu-brand)]">2.</strong> We walk through Eduvia with your team.</li>
    <li><strong class="text-[var(--edu-brand)]">3.</strong> We plan a realistic rollout.</li>
  </ol>
</aside>
