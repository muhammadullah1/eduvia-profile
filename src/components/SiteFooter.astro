---
import { navLinks, site } from '../data/site';
---

<footer class="edu-footer">
  <div class="wrap edu-footer-grid">
    <div class="edu-footer-brand">
      <a href="/" class="edu-logo" aria-label={`${site.name} home`}>
        <img
          class="edu-logo-image"
          src="/eduvia-logo.svg"
          alt={site.name}
          width="176"
          height="44"
          decoding="async"
        />
      </a>
      <p>{site.description}</p>
      <p class="edu-footer-by">
        A school management product by
        <a href={site.abler.url} rel="noopener noreferrer">{site.abler.name}</a>
      </p>
    </div>
    <div>
      <p class="edu-footer-label">Product</p>
      <ul class="edu-footer-links">
        {navLinks.filter((l) => !['/contact', '/faq'].includes(l.href)).map((l) => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <p class="edu-footer-label">Contact</p>
      <ul class="edu-footer-links">
        <li><a href="/contact">Request a demo</a></li>
        <li><a href={`mailto:${site.abler.email}`}>{site.abler.email}</a></li>
        <li><a href={site.abler.phoneHref}>{site.abler.phone}</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap edu-footer-bar">
    <span>© {new Date().getFullYear()} {site.abler.name}</span>
    <span>{site.abler.location}</span>
  </div>
</footer>
