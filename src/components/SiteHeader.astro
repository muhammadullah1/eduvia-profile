---
import { navLinks, site } from '../data/site';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="edu-header">
  <div class="wrap edu-header-row">
    <a href="/" class="edu-logo" aria-label={`${site.name} home`}>
      <img
        class="edu-logo-image"
        src="/eduvia-logo.svg"
        alt={site.name}
        width="176"
        height="44"
        decoding="async"
        fetchpriority="high"
      />
    </a>

    <nav class="edu-nav" aria-label="Primary">
      {navLinks.map((link) => (
        <a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>
          {link.label}
        </a>
      ))}
    </nav>

    <div class="edu-header-actions">
      <a href="/contact" class="btn btn-primary">Request a demo</a>
    </div>

    <details class="edu-mobile-nav">
      <summary aria-label="Menu">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h16M4 18h16"/></svg>
      </summary>
      <div class="edu-mobile-panel">
        {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
        <a href="/contact" class="btn btn-primary btn-block">Request a demo</a>
      </div>
    </details>
  </div>
</header>
