---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import type { PageMeta } from '../data/site';
import { site, pageUrl } from '../data/site';

interface Props {
  meta: PageMeta;
  breadcrumbs?: { label: string; href?: string }[];
}

const { meta, breadcrumbs = [] } = Astro.props;
const origin = Astro.site?.href ?? 'https://www.eduvia.app';
const canonical = pageUrl(meta.path, origin);
const ogImage = meta.ogImage ?? '/og-image.svg';
const ogImageAbsolute = ogImage.startsWith('http') ? ogImage : pageUrl(ogImage, origin);
const ogImageAlt =
  meta.ogImageAlt ??
  `${site.name} school management platform preview`;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${origin}/#organization`,
      name: site.name,
      url: origin,
      logo: pageUrl('/eduvia-mark.svg', origin),
      description: site.description,
      parentOrganization: {
        '@type': 'Organization',
        name: site.abler.name,
        url: site.abler.url,
      },
    },
    {
      '@type': 'SoftwareApplication',
      name: site.name,
      applicationCategory: 'EducationApplication',
      operatingSystem: 'Web',
      description: site.description,
      url: origin,
      provider: {
        '@type': 'Organization',
        name: site.abler.name,
      },
    },
    {
      '@type': 'WebSite',
      name: site.name,
      url: origin,
      description: site.description,
      publisher: { '@id': `${origin}/#organization` },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={meta.robots ?? 'index, follow'} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:image" content={ogImageAbsolute} />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={ogImageAbsolute} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource-variable/geist@5.2.8/index.min.css" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/eduvia-mark.svg" />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  </head>
  <body class="min-h-screen flex flex-col antialiased">
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    {breadcrumbs.length > 0 && (
      <nav aria-label="Breadcrumb" class="breadcrumb">
        <ol class="wrap">
          <li>
            <a href="/" class="hover:text-foreground">Home</a>
          </li>
          {breadcrumbs.map((crumb) => (
            <li class="flex items-center gap-1">
              <span aria-hidden="true">/</span>
              {crumb.href ? (
                <a href={crumb.href} class="hover:text-foreground">{crumb.label}</a>
              ) : (
                <span class="text-foreground font-medium" aria-current="page">{crumb.label}</span>
              )}
            </li>
          ))}
        </ol>
      </nav>
    )}
    <main id="main" class="flex-1">
      <slot />
    </main>
    <SiteFooter />
    <script is:inline>
      const reveal = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.08, rootMargin: '0px 0px -24px' },
        );
        reveal.forEach((el) => io.observe(el));
      } else {
        reveal.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
